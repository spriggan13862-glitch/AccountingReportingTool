# =============================================================================
# Accounting Tool — Environment Configuration
# Copy this file to .env and fill in values for your environment.
# Never commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production

# ---------------------------------------------------------------------------
# Security — REQUIRED in staging/production
# ---------------------------------------------------------------------------
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production-must-be-32-chars-min

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60    # 1 hour
REFRESH_TOKEN_EXPIRE_DAYS=7

MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Development (SQLite)
DATABASE_URL=sqlite:///./accounting.db

# Production (PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/accounting_tool

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# QuickBooks Integration
# ---------------------------------------------------------------------------
# Register a sandbox app at https://developer.intuit.com to obtain these values.
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=http://localhost:5173/quickbooks/callback
QB_ENVIRONMENT=sandbox        # sandbox | production
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QB_ENCRYPTION_KEY=
# Optional — overrides the frontend base URL used in OAuth redirects
# FRONTEND_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                    # true in production for structured JSON logs
